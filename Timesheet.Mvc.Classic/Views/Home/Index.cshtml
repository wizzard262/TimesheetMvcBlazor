@using Timesheet.Mvc.Classic.ViewModels

@model HomepageViewModel

@{
    ViewData["Title"] = "Timesheet";

    // this is not ideal using a pair of different variables that work together
    // in a production project better to have a strongly-typed object
    var message = TempData["Message"] as string;
    var type = TempData["MessageType"] as string ?? "alert-info";
}

<section class="hero">
    <div class="wrap">
        <p class="eyebrow">C# .NET &middot; ASP.NET Core MVC &middot; Microsoft Entra ID &middot; Azure</p>
        <h1>Timesheet</h1>
        <p class="lead">Add, edit and delete timesheet entries, then report hours per project for a user and week.
            One of three front ends built on the same application layer.</p>
    </div>
</section>

<main class="wrap grid">
    <section class="card card-wide" aria-labelledby="entries-title">
        <h2 id="entries-title">Timesheet entries</h2>
        <p class="muted small">Change a row and press Update, or add a new one at the bottom. Hours must be between 0.25 and 12; dates can't be in the future.</p>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="notice @type" role="status">@message</div>
        }

        <div class="entries">
            <div class="entry-head" aria-hidden="true">
                <span>ID</span><span>User</span><span>Project</span><span>Date</span><span>Hours</span><span>Description</span><span></span>
            </div>

            @if (Model.TimesheetEntries != null)
            {
                foreach (var timesheetEntryDto in Model.TimesheetEntries)
                {
                    <partial name="_TimesheetRow" model="new TimesheetRowViewModel { TimesheetEntryDto = timesheetEntryDto, IsEditable = true }" />
                }
            }

            <form asp-action="Add" method="post" class="entry-row add">
                <span class="entry-id">New</span>
                <label class="field"><span class="field-label">User</span>
                    <input asp-for="NewTimesheetEntry.UserId" min="1" />
                    <span asp-validation-for="NewTimesheetEntry.UserId" class="text-danger"></span>
                </label>
                <label class="field"><span class="field-label">Project</span>
                    <input asp-for="NewTimesheetEntry.ProjectId" min="1" />
                    <span asp-validation-for="NewTimesheetEntry.ProjectId" class="text-danger"></span>
                </label>
                <label class="field"><span class="field-label">Date</span>
                    <input asp-for="NewTimesheetEntry.Date" />
                    <span asp-validation-for="NewTimesheetEntry.Date" class="text-danger"></span>
                </label>
                <label class="field"><span class="field-label">Hours</span>
                    <input asp-for="NewTimesheetEntry.Hours" type="number" step="0.25" />
                    <span asp-validation-for="NewTimesheetEntry.Hours" class="text-danger"></span>
                </label>
                <label class="field field-wide"><span class="field-label">Description</span>
                    <input asp-for="NewTimesheetEntry.Description" />
                </label>
                <div class="row-actions">
                    <button type="submit" class="button">Add</button>
                </div>
            </form>
        </div>
    </section>

    <partial name="_Variants" model="@("Classic")" />

    <section class="card card-wide" aria-labelledby="entra-title">
        <h2 id="entra-title">Microsoft Entra ID: sign in and roles</h2>
        <p>Use the links in the bar at the top: sign in and out, try the admin-only and user-only pages, and list every claim Entra sends in <b>My roles</b>.</p>
        <div class="creds">
            <div>
                <b>Basic user</b><br />
                user@jonesstevelive.onmicrosoft.com (password: 4Candles)<br />
                <span class="small muted">Can open the user page, not the admin page.</span>
            </div>
            <div>
                <b>Admin user</b><br />
                admin@jonesstevelive.onmicrosoft.com (password: Fork_Handles)<br />
                <span class="small muted">Can open both pages (admins also have the user role).</span>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
