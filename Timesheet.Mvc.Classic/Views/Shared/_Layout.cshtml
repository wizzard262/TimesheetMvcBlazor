<!DOCTYPE html>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Timesheet (MVC Classic)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">Timesheet</a>
            <span class="variant">MVC Classic</span>
            <nav class="nav" aria-label="Pages">
                <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Timesheet</a>
                <a class="@(controller == "Reporting" ? "active" : "")" asp-controller="Reporting" asp-action="Index">Reports</a>
                <a class="@(controller == "Abstraction" ? "active" : "")" asp-controller="Abstraction" asp-action="Index">Branch by abstraction</a>
            </nav>
        </div>
    </header>

    <!-- Microsoft Entra ID sign-in -->
    <div class="authbar">
        <div class="wrap">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="who">Signed in as <b>@User.Identity.Name</b></span>
                <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignOut">Sign out</a>
            }
            else
            {
                <span class="who">Microsoft Entra ID test</span>
                <a asp-area="MicrosoftIdentity" asp-controller="Account" asp-action="SignIn">Sign in</a>
            }
            <a asp-controller="Home" asp-action="AdminOnlyPage">Admin only page</a>
            <a asp-controller="Home" asp-action="UserOnlyPage">User only page</a>
            <a asp-controller="Home" asp-action="MyRoles">My roles</a>
        </div>
    </div>

    @RenderBody()

    <footer class="footer">
        <div class="wrap">
            Timesheet by Steve Jones &middot;
            <a href="https://dev.azure.com/jones-steve/_git/Timesheet">Code on Azure DevOps</a> &middot;
            <a href="https://www.harriercarrier.com/portfolio.html">Portfolio</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
