@using Timesheet.Mvc.Classic.ViewModels

@model TimesheetRowViewModel

@if (Model.IsEditable)
{
    // One form per row (a <form> can't wrap a table row, so rows are grid rows)
    <form asp-action="RowAction" method="post" class="entry-row">
        <span class="entry-id">
            <input asp-for="TimesheetEntryDto.Id" type="hidden" />
            #@(Model.TimesheetEntryDto?.Id ?? 0)
        </span>
        <label class="field"><span class="field-label">User</span>
            <input asp-for="TimesheetEntryDto.UserId" min="1" />
        </label>
        <label class="field"><span class="field-label">Project</span>
            <input asp-for="TimesheetEntryDto.ProjectId" min="1" />
        </label>
        <label class="field"><span class="field-label">Date</span>
            <input asp-for="TimesheetEntryDto.Date" type="date" />
        </label>
        <label class="field"><span class="field-label">Hours</span>
            <input asp-for="TimesheetEntryDto.Hours" type="number" step="0.25" />
        </label>
        <label class="field field-wide"><span class="field-label">Description</span>
            <input asp-for="TimesheetEntryDto.Description" />
        </label>
        <div class="row-actions">
            <button type="submit" name="action" value="update" class="button button-ghost">Update</button>
            <button type="submit" name="action" value="delete" class="button button-danger">Delete</button>
        </div>
    </form>
}
else
{
    <tr>
        <td data-label="ID">#@(Model.TimesheetEntryDto?.Id ?? 0)</td>
        <td data-label="User">@Model.TimesheetEntryDto?.UserId</td>
        <td data-label="Project">@Model.TimesheetEntryDto?.ProjectId</td>
        <td data-label="Date">@(Model.TimesheetEntryDto?.Date.ToString("ddd d MMM yyyy") ?? "")</td>
        <td data-label="Hours" class="num">@Model.TimesheetEntryDto?.Hours</td>
        <td data-label="Description">@Model.TimesheetEntryDto?.Description</td>
    </tr>
}
