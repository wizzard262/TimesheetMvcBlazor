@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="hero">
    <div class="wrap">
        <p class="eyebrow">Timesheet</p>
        <h1>Something went wrong</h1>
        <p class="lead">The request couldn't be completed.</p>
    </div>
</section>

<main class="wrap grid">
    <section class="card card-wide">
        @if (Model.ShowRequestId)
        {
            <p><b>Request ID:</b> <code>@Model.RequestId</code></p>
        }
        <p><a class="button" href="/">Back to the timesheet</a></p>
    </section>
</main>
