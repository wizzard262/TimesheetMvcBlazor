<!DOCTYPE html>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Timesheet (MVC + Razor Components)</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">Timesheet</a>
            <span class="variant">MVC + Razor Components</span>
            <nav class="nav" aria-label="Pages">
                <a class="@(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Timesheet</a>
                <a class="@(controller == "Reporting" ? "active" : "")" asp-controller="Reporting" asp-action="Index">Reports</a>
                <a class="@(controller == "Abstraction" ? "active" : "")" asp-controller="Abstraction" asp-action="Index">Branch by abstraction</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="wrap">
            Timesheet by Steve Jones &middot;
            <a href="https://dev.azure.com/jones-steve/_git/Timesheet">Code on Azure DevOps</a> &middot;
            <a href="https://www.harriercarrier.com/portfolio.html">Portfolio</a>
        </div>
    </footer>

    <script src="_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
