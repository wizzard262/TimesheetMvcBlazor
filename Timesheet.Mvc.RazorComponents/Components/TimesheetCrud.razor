@using Microsoft.AspNetCore.Components.Forms
@using Timesheet.Core.Models.Dto
@using Timesheet.Core.Services
@inject ITimesheetService TimesheetService
@inject Microsoft.Extensions.Logging.ILogger<TimesheetCrud> Logger

<section class="card card-wide" aria-labelledby="crud-title">
    <h2 id="crud-title">Add a timesheet entry</h2>
    <p class="muted small">This box is a Blazor component (.razor) inside an MVC page. If it can't connect to the server, Save does nothing: that is the fragility described below.</p>

    <EditForm EditContext="editContext" class="form-grid">
        <label>User ID
            <InputNumber @bind-Value="TimesheetEntryInsertDto.UserId" />
        </label>
        <label>Project ID
            <InputNumber @bind-Value="TimesheetEntryInsertDto.ProjectId" />
        </label>
        <label>Date
            <InputDate @bind-Value="TimesheetEntryInsertDto.Date" />
        </label>
        <label>Hours
            <InputNumber @bind-Value="TimesheetEntryInsertDto.Hours" />
        </label>
        <label>Description
            <InputText @bind-Value="TimesheetEntryInsertDto.Description" />
        </label>
        <div>
            <!-- Use a button with type="button" and an @onclick handler to avoid full browser POST -->
            <button type="button" class="button" @onclick="SubmitForm">Save</button>
        </div>

        <DataAnnotationsValidator />
        <ValidationSummary />
    </EditForm>

    @if (TimesheetEntryDto is not null)
    {
        <div class="notice alert-success" role="status">Saved entry ID: #@TimesheetEntryDto.Id</div>
    }
</section>

@code {
    private TimesheetEntryInsertDto TimesheetEntryInsertDto = new();
    private TimesheetEntryDto? TimesheetEntryDto;
    private EditContext editContext = default!;

    protected override void OnInitialized()
    {
        // Initialize the EditContext once for the form model
        editContext = new EditContext(TimesheetEntryInsertDto);
    }

    // Make the handler async so Blazor can await it; add logging and error handling.
    private async Task SubmitForm()
    {
        Logger?.LogDebug("SubmitForm invoked.");
        // Validate the current model; do not perform a browser POST.
        if (!editContext.Validate())
        {
            Logger?.LogDebug("Validation failed.");
            return;
        }

        try
        {
            // If the service is synchronous, run it on a background thread to avoid UI blocking.
            TimesheetEntryDto = await System.Threading.Tasks.Task.Run(() => TimesheetService.Add(TimesheetEntryInsertDto));

            Logger?.LogInformation("Timesheet entry saved with ID {Id}", TimesheetEntryDto?.Id);
        }
        catch (System.Exception ex)
        {
            Logger?.LogError(ex, "Error saving timesheet entry");
        }
        finally
        {
            StateHasChanged();
        }
    }
}
