@page "/"

@using Timesheet.Core.Models.Dto
@using Timesheet.Core.Services

@inject ITimesheetService TimesheetService

<PageTitle>Timesheet (Blazor Server)</PageTitle>

<section class="hero">
    <div class="wrap">
        <p class="eyebrow">C# .NET &middot; Blazor Server &middot; SignalR &middot; Azure</p>
        <h1>Timesheet</h1>
        <p class="lead">Add, edit and delete timesheet entries without page reloads, then report hours per project for a user and week.
            One of three front ends built on the same application layer.</p>
    </div>
</section>

<main class="wrap grid">
    <section class="card card-wide" aria-labelledby="entries-title">
        <h2 id="entries-title">Timesheet entries</h2>
        <p class="muted small">Change a row and press Update, or add a new one at the bottom. Hours must be between 0.25 and 12; dates can't be in the future.</p>

        @if (_message.Show)
        {
            <div class="notice alert-success" role="status">@_message.Text</div>
        }

        <div class="entries">
            <div class="entry-head" aria-hidden="true">
                <span>ID</span><span>User</span><span>Project</span><span>Date</span><span>Hours</span><span>Description</span><span></span>
            </div>

            <!-- EXISTING ROWS: one form per row -->
            @foreach (var entry in _timesheetEntries)
            {
                var ctx = _rowEditContexts[entry.Id];

                <EditForm EditContext="@ctx" OnValidSubmit="() => HandleUpdateRow(entry, ctx)" class="entry-row" @key="entry.Id">
                    <span class="entry-id">#@entry.Id</span>
                    <label class="field"><span class="field-label">User</span>
                        <InputNumber @bind-Value="entry.UserId" min="1" />
                    </label>
                    <label class="field"><span class="field-label">Project</span>
                        <InputNumber @bind-Value="entry.ProjectId" min="1" />
                    </label>
                    <label class="field"><span class="field-label">Date</span>
                        <InputDate @bind-Value="entry.Date" />
                    </label>
                    <label class="field"><span class="field-label">Hours</span>
                        <InputNumber @bind-Value="entry.Hours" step="0.25" />
                    </label>
                    <label class="field field-wide"><span class="field-label">Description</span>
                        <InputText @bind-Value="entry.Description" />
                    </label>
                    <div class="row-actions">
                        <!--Note: Delete can be a button but to get "Update" changes this button must be a submit -->
                        <button type="submit" class="button button-ghost">Update</button>
                        <button type="button" class="button button-danger" @onclick="() => HandleDeleteRow(entry)">Delete</button>
                    </div>
                    <div class="row-errors">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                    </div>
                </EditForm>
            }

            <!-- ADD NEW ENTRY -->
            <EditForm EditContext="@_addEditContext" OnValidSubmit="HandleAddRow" class="entry-row add">
                <span class="entry-id">New</span>
                <label class="field"><span class="field-label">User</span>
                    <InputNumber @bind-Value="_timesheetEntryInsertDto.UserId" min="1" />
                </label>
                <label class="field"><span class="field-label">Project</span>
                    <InputNumber @bind-Value="_timesheetEntryInsertDto.ProjectId" min="1" />
                </label>
                <label class="field"><span class="field-label">Date</span>
                    <InputDate @bind-Value="_timesheetEntryInsertDto.Date" />
                </label>
                <label class="field"><span class="field-label">Hours</span>
                    <InputNumber @bind-Value="_timesheetEntryInsertDto.Hours" step="0.25" />
                </label>
                <label class="field field-wide"><span class="field-label">Description</span>
                    <InputText @bind-Value="_timesheetEntryInsertDto.Description" />
                </label>
                <div class="row-actions">
                    <button type="submit" class="button">Add</button>
                </div>
                <div class="row-errors">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                </div>
            </EditForm>
        </div>
    </section>

    <Variants Current="Blazor" />
</main>

@code
{
    private TimesheetEntryInsertDto _timesheetEntryInsertDto = new();
    private List<TimesheetEntryDto> _timesheetEntries = new();
    private Dictionary<int, EditContext> _rowEditContexts = new();
    private EditContext? _addEditContext;
    private (bool Show, string Text) _message = (false, string.Empty);

    protected override void OnInitialized()
    {
        _addEditContext = new EditContext(_timesheetEntryInsertDto);
        _timesheetEntries = TimesheetService.GetAll().ToList();

        foreach (var entry in _timesheetEntries)
        {
            _rowEditContexts[entry.Id] = new EditContext(entry);
        }
    }

    private void HandleAddRow()
    {
        // Add the new entry and get the created DTO with its assigned ID
        var timesheetEntryDto = TimesheetService.Add(_timesheetEntryInsertDto);
        _timesheetEntries.Add(timesheetEntryDto);

        ShowMessage($"Timesheet entry added with ID #{timesheetEntryDto?.Id}");

        // Add the new entry's EditContext to the dictionary so it can be edited immediately
        _rowEditContexts.Add(timesheetEntryDto!.Id, new EditContext(timesheetEntryDto));

        // Reset the form model and validation state
        _timesheetEntryInsertDto = new TimesheetEntryInsertDto();
        _addEditContext = new EditContext(_timesheetEntryInsertDto);
    }

    private void HandleUpdateRow(TimesheetEntryDto entry, EditContext context)
    {
        // if we do not validate, the entry is not updated
        if (!context.Validate())
        {
            return;
        }

        TimesheetService.Update(entry);
        ShowMessage($"Timesheet entry #{entry?.Id} updated successfully.");
    }

    private void HandleDeleteRow(TimesheetEntryDto entry)
    {
        TimesheetService.Delete(entry.Id);
        _timesheetEntries.Remove(entry);
        _rowEditContexts.Remove(entry.Id);

        ShowMessage($"Timesheet entry #{entry?.Id} deleted.");
    }

    private void ShowMessage(string message)
    {
        _message = (true, message);
    }
}
