@using Timesheet.Core.Models.Dto

<tr>
    <td data-label="ID">#@(TimesheetEntryDto?.Id ?? 0)</td>
    <td data-label="User">@TimesheetEntryDto?.UserId</td>
    <td data-label="Project">@TimesheetEntryDto?.ProjectId</td>
    <td data-label="Date">@(TimesheetEntryDto?.Date.ToString("ddd d MMM yyyy") ?? "")</td>
    <td data-label="Hours" class="num">@TimesheetEntryDto?.Hours</td>
    <td data-label="Description">@TimesheetEntryDto?.Description</td>
</tr>

@code {
    [Parameter] public TimesheetEntryDto? TimesheetEntryDto { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; }
}
